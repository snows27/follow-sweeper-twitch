# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# From https://dev.twitch.tv/console -> Applications -> Register Your Application
#   OAuth Redirect URL: http://localhost:3000/api/auth/callback
#   Category: Application Integration
#   Client Type: Confidential
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public URL of this app (no trailing slash). Must match the redirect URL's origin.
APP_URL=http://localhost:3000
